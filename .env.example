# ─────────────────────────────────────────────────────────────────────────────
#  کیهان — نمونهٔ متغیرهای محیطی
#  Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used to sign Payload auth cookies/JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string

# ── Database (Postgres + pgvector) ──────────────────────────────────────────
POSTGRES_USER=kayhan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kayhan
DATABASE_URI=postgres://kayhan:change-me@localhost:5432/kayhan

# ── Object storage (MinIO, S3-compatible) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kayhan-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me
# How the browser reaches MinIO (feeds next.config.ts image remotePatterns)
S3_PUBLIC_PROTOCOL=http
S3_PUBLIC_HOSTNAME=localhost
S3_PUBLIC_PORT=9000

# ── LLM (OpenAI-compatible endpoint) ────────────────────────────────────────
# Default: self-hosted vLLM. Swap these three vars to point anywhere else —
# no code changes required.
AI_BASE_URL=http://localhost:8000/v1
AI_MODEL=Qwen/Qwen3-14B-AWQ
AI_API_KEY=not-needed-for-local-vllm
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=1024

# ── Embeddings (self-hosted Hakim, Persian-specific) ────────────────────────
EMBEDDINGS_BASE_URL=http://localhost:8080
EMBEDDINGS_MODEL=MCINext/Hakim
# Must match the vector(N) width in the migration. Hakim = 768.
EMBEDDINGS_DIM=768

# ── RAG tuning ──────────────────────────────────────────────────────────────
RAG_TOP_K=6
RAG_MIN_SCORE=0.25

# ── Email (SMTP — used for verification + password reset) ───────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=کیهان
EMAIL_FROM_ADDRESS=noreply@example.com

# ── Rate limiting ───────────────────────────────────────────────────────────
CHAT_RATE_LIMIT_PER_HOUR_ANON=10
CHAT_RATE_LIMIT_PER_HOUR_MEMBER=60
