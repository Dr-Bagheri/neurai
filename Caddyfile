# Caddy terminates TLS and fronts the Next.js server.
# Automatic HTTPS via Let's Encrypt needs port 80/443 reachable and a public
# domain. If the host is inside Iran and ACME is unreachable, swap the site
# block for `{$SITE_DOMAIN}:443` plus an explicit `tls /path/cert.pem /path/key.pem`.

{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# Long-cache immutable build output and self-hosted fonts.
	@immutable path /_next/static/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy web:3000 {
		# The AI assistant streams tokens; disabling buffering keeps the
		# response flowing rather than arriving in one lump at the end.
		flush_interval -1
	}
}
